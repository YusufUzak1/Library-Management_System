<Application x:Class="Scriptorium.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Scriptorium.Core"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Value Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <core:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <core:NullToVisibilityConverter x:Key="NullToVis" />
            <core:StatusKindToBackgroundConverter x:Key="StatusBgConverter" />
            <core:StatusKindToForegroundConverter x:Key="StatusFgConverter" />
            <core:StatusKindToBorderConverter x:Key="StatusBorderConverter" />
            <core:HexToBrushConverter x:Key="HexToBrushConverter" />
            <core:StringMatchToVisibilityConverter x:Key="ScreenVisConverter" />
            <core:StringMatchToBoolConverter x:Key="ScreenBoolConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

