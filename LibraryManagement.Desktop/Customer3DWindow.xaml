<Window x:Class="LibraryManagement.Desktop.Customer3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LibraryManagement.Desktop"
        Title="Kütüphane Ödünç &amp; İade Masası" Width="1360" Height="820"
        WindowStartupLocation="CenterScreen" Background="#0D0804"
        WindowStyle="None"
        FontFamily="Segoe UI, Segoe UI Variable Text"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseDown="OnWindowMouseDown"
        KeyDown="OnKeyDown" MouseMove="OnMouseMove">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 1600x900 Stage container matching customer-3d.html -->
    <Border Grid.Row="0" Margin="10,6,10,0" CornerRadius="10" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border.Effect>
        <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.6"/>
      </Border.Effect>
      <Viewbox Stretch="Uniform">
        <Grid Width="1600" Height="900" Background="#1A0F08" ClipToBounds="True">

          <!-- 3D Viewport (Three.js canvas equivalent in native WPF 3D) -->
          <Viewport3D x:Name="WorldViewport" Width="1600" Height="900" ClipToBounds="True" IsHitTestVisible="False">
            <Viewport3D.Camera>
              <PerspectiveCamera x:Name="Cam" Position="0,2.05,6.5" LookDirection="0,-0.35,-6.5" UpDirection="0,1,0" FieldOfView="67" NearPlaneDistance="0.1" FarPlaneDistance="60"/>
            </Viewport3D.Camera>
            <ModelVisual3D x:Name="SceneRoot"/>
            <ModelVisual3D x:Name="BooksRoot"/>
          </Viewport3D>

          <!-- Atmospheric vignette & depth fog overlay -->
          <Rectangle Width="1600" Height="900" IsHitTestVisible="False">
            <Rectangle.Fill>
              <RadialGradientBrush Center="0.5,0.5" RadiusX="0.78" RadiusY="0.78">
                <GradientStop Color="#001A0F08" Offset="0.55"/>
                <GradientStop Color="#AA0D0804" Offset="1"/>
              </RadialGradientBrush>
            </Rectangle.Fill>
          </Rectangle>

          <!-- Left #welcome overlay -->
          <Canvas Width="1600" Height="900">
            <StackPanel Canvas.Left="70" Canvas.Top="300" Width="490">
              <TextBlock x:Name="DisplayTitle" Text="Yeni Kitap Ekle" FontFamily="Georgia" FontSize="56" Foreground="#FBF3E0" TextWrapping="Wrap">
                <TextBlock.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.8"/>
                </TextBlock.Effect>
              </TextBlock>
              <Rectangle Width="110" Height="2" Fill="#E4B368" HorizontalAlignment="Left" Margin="0,10,0,16"/>
              <TextBlock x:Name="Sub" Text="Lütfen masaya eklemek istediğiniz kitapları seçin." FontSize="20" Foreground="#EADFC8" TextWrapping="Wrap" LineHeight="28">
                <TextBlock.Effect>
                  <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.8"/>
                </TextBlock.Effect>
              </TextBlock>
              <Button Content="🔍  Kitap Ara &amp; Masaya Ekle" Width="260" Height="46" Margin="0,20,0,0"
                      HorizontalAlignment="Left" Style="{StaticResource GlassButton}" BorderBrush="#E4B368"
                      FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="OnOpenSearchOverlay">
                <Button.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#88C58B4A" Offset="0"/>
                    <GradientStop Color="#448F5F2B" Offset="1"/>
                  </LinearGradientBrush>
                </Button.Background>
              </Button>
            </StackPanel>

            <!-- Right #panel overlay -->
            <Border Canvas.Left="1230" Canvas.Top="50" Width="330" Padding="16" CornerRadius="18"
                    Background="#99281E16" BorderBrush="#40FFFFFF" BorderThickness="1">
              <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.5"/>
              </Border.Effect>
              <StackPanel>
                <Grid Margin="4,0,4,10">
                  <TextBlock x:Name="PanelTitle" Text="▣ Kitap Ekleme İşlemi" FontSize="16" FontWeight="SemiBold" Foreground="#F4EFE6" VerticalAlignment="Center"/>
                  <TextBlock x:Name="PanelId" Text="#KE-10427" FontSize="11" Foreground="#C9BFAE" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Steps box (.box #steps) -->
                <Border Background="#14FFFFFF" CornerRadius="12" Padding="14,8" Margin="0,0,0,12">
                  <StackPanel x:Name="StepsHost"/>
                </Border>

                <!-- Book list box (.box #list) -->
                <Border Background="#14FFFFFF" CornerRadius="12" Padding="14,10">
                  <StackPanel>
                    <TextBlock x:Name="ListTitle" Text="Masadaki Kitaplar (0)" FontSize="14" FontWeight="SemiBold" Foreground="#F4EFE6" Margin="0,2,0,6"/>
                    <StackPanel x:Name="BookListHost"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Canvas>

          <!-- Fullscreen Book Search Page Overlay -->
          <Grid x:Name="SearchOverlay" Width="1600" Height="900" Visibility="Collapsed" Background="#F2140D08">
            <Border Margin="50,30" CornerRadius="28" Background="#7522160E" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="32,24" ClipToBounds="True">
              <Border.Effect>
                <DropShadowEffect BlurRadius="50" ShadowDepth="12" Opacity="0.6"/>
              </Border.Effect>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Header with Search Box and Close Button -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="540"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#E4B368" Margin="0,0,12,0" VerticalAlignment="Center"/>
                      <TextBlock Text="Kütüphane Kitap Arama &amp; Katalog" FontFamily="Georgia" FontSize="28" FontWeight="SemiBold" Foreground="#FFFDF9" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Kütüphane arşivimizdeki eserleri arayın ve dilediğinizi doğrudan masanıza ekleyin." FontSize="14" Foreground="#ECE4D6" Margin="38,4,0,0"/>
                  </StackPanel>

                  <!-- Search Input Box -->
                  <Border Grid.Column="1" Style="{StaticResource Glass}" CornerRadius="22" Height="46" Padding="16,0" VerticalAlignment="Center">
                    <Grid>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#FFFDF9" FontSize="16" Margin="0,0,10,0"/>
                        <TextBox x:Name="CustomerSearchBox" Background="Transparent" BorderThickness="0" Foreground="#FFFDF9" CaretBrush="#E4B368" FontSize="14" Width="400" VerticalAlignment="Center" TextChanged="OnCustomerSearchChanged"/>
                      </StackPanel>
                      <TextBlock x:Name="CustomerSearchPlaceholder" IsHitTestVisible="False" Text="Kitap adı, yazar, ISBN veya anahtar kelime..." Foreground="#EAE2D5" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="28,0,0,0"/>
                    </Grid>
                  </Border>

                  <!-- Close / Return to Desk Button -->
                  <Button Grid.Column="2" Content="🏛️  Masaya Dön" Height="44" Padding="20,0" Margin="16,0,0,0"
                          Style="{StaticResource GlassButton}" BorderBrush="#8FD6A0" FontSize="14" FontWeight="SemiBold"
                          Click="OnCloseSearchOverlay">
                    <Button.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#5FAE72" Offset="0"/>
                        <GradientStop Color="#2F6B46" Offset="1"/>
                      </LinearGradientBrush>
                    </Button.Background>
                  </Button>
                </Grid>

                <!-- Row 1: Category Filter Buttons -->
                <StackPanel x:Name="CategoryFiltersHost" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14"/>

                <!-- Row 2: Scrollable Results Grid -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <WrapPanel x:Name="SearchResultsHost" Margin="0,4,0,10"/>
                </ScrollViewer>

                <!-- Row 3: Bottom Status Bar -->
                <Border Grid.Row="3" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                  <Grid>
                    <TextBlock x:Name="SearchStatusText" Text="Toplam eser listeleniyor" FontSize="14" FontWeight="Medium" Foreground="#ECE4D6" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock x:Name="SelectedCountText" Text="Masanızda 0 kitap var" FontSize="14" FontWeight="SemiBold" Foreground="#7FD08F" VerticalAlignment="Center" Margin="0,0,20,0"/>
                      <Button Content="✓  Seçimi Tamamla &amp; Masaya Git" Height="40" Padding="22,0"
                              Style="{StaticResource GlassButton}" BorderBrush="#8FD6A0" Click="OnCloseSearchOverlay"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Viewbox>
    </Border>

    <!-- Bottom control bar (#bar from customer-3d.html) -->
    <WrapPanel x:Name="ControlBar" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
      <Button x:Name="ModeBtn" Content="Mod: Kitap Ekleme" Height="40" Padding="18,0" Margin="5,0" FontSize="13" FontWeight="SemiBold"
              Style="{StaticResource GlassButton}" Click="OnToggleMode"/>
      <Button Content="Rastgele Kitap" Height="40" Padding="18,0" Margin="5,0" FontSize="13" FontWeight="SemiBold"
              Style="{StaticResource GlassButton}" Click="OnAddBook"/>
      <Button Content="Son kitabı çıkar" Height="40" Padding="18,0" Margin="5,0" FontSize="13" FontWeight="SemiBold"
              Style="{StaticResource GlassButton}" Click="OnRemoveBook"/>
      <Button Content="Onayla" Height="40" Padding="18,0" Margin="5,0" FontSize="13" FontWeight="SemiBold"
              Style="{StaticResource GlassButton}" BorderBrush="#8FD6A0" Click="OnConfirm">
        <Button.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5FAE72" Offset="0"/>
            <GradientStop Color="#2F6B46" Offset="1"/>
          </LinearGradientBrush>
        </Button.Background>
      </Button>
      <Button Content="&#xE8AC;  Giriş Ekranına Dön" FontFamily="Segoe MDL2 Assets, Segoe UI" Height="40" Padding="18,0" Margin="15,0,5,0" FontSize="13" FontWeight="SemiBold"
              Style="{StaticResource GlassButton}" Background="#22E4B368" BorderBrush="#77E4B368" Foreground="#E4B368" Click="OnLogoutCustomer"/>
    </WrapPanel>

    <!-- Top-Left Title Badge -->
    <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,16,0,0"
            Background="#40140C06" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,6">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="🏛️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="Kütüphane Kiosku" FontSize="13" FontWeight="SemiBold" Foreground="#EADFC8" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Top-Right Window Controls -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,24,0">
      <Button ToolTip="Simge Durumuna Küçült" Width="36" Height="38" Margin="0,0,6,0"
              Style="{StaticResource GlassButton}" Click="OnMinimizeCustomer" Cursor="Hand">
        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#C9BFAE" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Button>
      <Button ToolTip="Tam Ekran (F11)" Width="36" Height="38" Margin="0,0,8,0"
              Style="{StaticResource GlassButton}" Click="OnToggleFullscreenCustomer" Cursor="Hand">
        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#C9BFAE" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Button>
      <Button Height="38" Padding="14,0" Style="{StaticResource GlassButton}"
              Background="#307A2E26" BorderBrush="#88F08A7A" Foreground="#F08A7A"
              Cursor="Hand" ToolTip="Uygulamayı Kapat" Click="OnExitCustomer">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="Kapat" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Glass Modal Dialog Layer -->
    <Grid x:Name="ModalHost" Grid.RowSpan="2" Visibility="Collapsed" Background="#B00D0704">
      <Border x:Name="ModalCard" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
              CornerRadius="24" Background="#E523170E" BorderBrush="#55FFFFFF" BorderThickness="1"
              Padding="28,26" ClipToBounds="True">
        <Border.Effect>
          <DropShadowEffect BlurRadius="45" ShadowDepth="10" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center">
          <Border x:Name="ModalIconCircle" Width="56" Height="56" CornerRadius="28" Background="#33F08A7A"
                  HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock x:Name="ModalIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                       Foreground="#F08A7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="ModalTitle" Text="Uygulamayı Kapat" FontSize="20" FontWeight="SemiBold"
                     Foreground="#FBF3E0" TextAlignment="Center" Margin="0,0,0,8"/>
          <TextBlock x:Name="ModalMessage" Text="Kütüphane Kullanıcı Ekranından çıkmak istediğinize emin misiniz?"
                     FontSize="13" Foreground="#C9BFAE" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                     Margin="0,0,0,24" LineHeight="19"/>
          
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ModalCancelBtn" Content="Vazgeç" Width="130" Height="40" Margin="0,0,12,0"
                    Style="{StaticResource GlassButton}" Click="OnModalCancelClick"/>
            <Button x:Name="ModalConfirmBtn" Content="Evet, Kapat" Width="130" Height="40"
                    Style="{StaticResource GlassButton}" Click="OnModalConfirmClick"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Floating Glass Toast Notification -->
    <Border x:Name="ToastHost" Grid.RowSpan="2" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
            Margin="0,32,0,0" CornerRadius="18" Padding="20,10" Background="#EA22140B" BorderBrush="#556FBF7F"
            BorderThickness="1" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5"/>
      </Border.Effect>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="ToastIcon" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#7FD08F" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="ToastText" Text="İşlem başarılı" FontSize="13" FontWeight="SemiBold" Foreground="#F4EFE6" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>

