<Window x:Class="LibraryManagement.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LibraryManagement.Desktop"
        Title="Fırat Üniversitesi Kütüphane Sistemi" Width="1440" Height="900"
        WindowStartupLocation="CenterScreen" Background="#1A0F08"
        WindowStyle="None"
        FontFamily="Segoe UI, Segoe UI Variable Text"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseDown="OnWindowMouseDown">
  <Grid>
    <local:ShelfBackground Seed="3"><local:ShelfBackground.Effect><BlurEffect Radius="14"/></local:ShelfBackground.Effect></local:ShelfBackground>
    <Rectangle Fill="#40140C06"/>
    <Border Margin="24" CornerRadius="28" Background="#58261A10" BorderBrush="#55FFFFFF" BorderThickness="1" ClipToBounds="True">
      <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.5"/></Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Background="#44000000">
          <DockPanel Margin="14,20,14,16">
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Glass}" CornerRadius="14" Padding="10" x:Name="Profile"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,20" x:Name="Logo"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="NavHost"/>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Main Workspace (Dynamic In-Page Host) -->
        <Grid Grid.Column="1" Margin="24,18,24,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Top Header Bar -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="HeaderPanel" VerticalAlignment="Center">
              <TextBlock x:Name="GreetingText" Text="Günaydın, Yusuf 👋" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
              <TextBlock x:Name="GreetingSub" Text="Kütüphane yönetim sistemine hoş geldiniz." FontSize="13" FontWeight="Medium" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Back to Home Button (Visible only on subpages) -->
              <Button x:Name="BackToDashboardBtn" Visibility="Collapsed" Style="{StaticResource GlassButton}" Margin="0,0,12,0" Padding="14,0" Height="40" Click="OnBackToDashboardClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#E4B368" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Ana Sayfaya Dön" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- In-Page Realtime Search Box -->
              <Border Style="{StaticResource Glass}" CornerRadius="20" Height="40" Padding="14,0" Width="340">
                <Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Ink}" Margin="0,0,10,0"/>
                    <TextBox x:Name="GlobalSearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}" CaretBrush="#E4B368" FontSize="13" Width="230" VerticalAlignment="Center" TextChanged="OnGlobalSearchChanged"/>
                  </StackPanel>
                  <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False" Text="Kitap, üye veya işlem ara..." Foreground="{StaticResource Muted}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="26,0,0,0"/>
                  <TextBlock Text="Ctrl + K" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}"/>
                </Grid>
              </Border>

              <!-- Window Controls: Minimize, Maximize, Close -->
              <Button ToolTip="Simge Durumuna Küçült" Width="36" Height="40" Margin="8,0,0,0"
                      Style="{StaticResource GlassButton}" Click="OnMinimizeAppClick" Cursor="Hand">
                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
              <Button ToolTip="Ekranı Kapla / Geri Yükle" Width="36" Height="40" Margin="4,0,0,0"
                      Style="{StaticResource GlassButton}" Click="OnMaximizeAppClick" Cursor="Hand">
                <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
              <Button x:Name="ExitAppBtn" ToolTip="Uygulamayı Kapat" Width="42" Height="40" Margin="4,0,0,0"
                      Style="{StaticResource GlassButton}" Background="#307A2E26" BorderBrush="#88F08A7A" Click="OnExitAppClick" Cursor="Hand">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="15" FontWeight="Bold" Foreground="#F08A7A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Main Dynamic Content Host -->
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <!-- 1. Default Dashboard Grid -->
            <Grid x:Name="DashboardView">
              <Grid.RowDefinitions>
                <RowDefinition Height="98"/>
                <RowDefinition Height="56"/>
                <RowDefinition Height="190"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- Stat Cards -->
              <UniformGrid Grid.Row="0" Rows="1" x:Name="StatsHost"/>

              <!-- Action Bar -->
              <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" x:Name="ActionsHost"/>

              <!-- Middle Row: Today, Recent, Monthly Chart -->
              <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="1.25*"/>
                  <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Glass}" Margin="0,0,7,0" Padding="16,12"><StackPanel x:Name="TodayHost"/></Border>
                <Border Grid.Column="1" Style="{StaticResource Glass}" Margin="7,0" Padding="16,12"><StackPanel x:Name="RecentHost"/></Border>
                <Border Grid.Column="2" Style="{StaticResource Glass}" Margin="7,0,0,0" Padding="16,12"><DockPanel x:Name="ChartHost"/></Border>
              </Grid>

              <!-- Bottom Row: Quick Access, Top Borrowed Books -->
              <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.35*"/>
                  <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Glass}" Margin="0,0,7,0" Padding="16,12"><DockPanel x:Name="QuickHost"/></Border>
                <Border Grid.Column="1" Style="{StaticResource Glass}" Margin="7,0,0,0" Padding="16,12"><StackPanel x:Name="TopHost"/></Border>
              </Grid>
            </Grid>

            <!-- 2. Subpage In-Page View Host (Directly on this main page) -->
            <Border x:Name="SubPageView" Style="{StaticResource Glass}" Visibility="Collapsed" Padding="20,16" ClipToBounds="True">
              <Grid x:Name="SubPageBody">
                <!-- Switched and rendered in-page -->
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- Glass Modal Dialog Layer -->
    <Grid x:Name="ModalHost" Visibility="Collapsed" Background="#B00D0704">
      <Border x:Name="ModalCard" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
              CornerRadius="24" Background="#E523170E" BorderBrush="#55FFFFFF" BorderThickness="1"
              Padding="28,26" ClipToBounds="True">
        <Border.Effect>
          <DropShadowEffect BlurRadius="45" ShadowDepth="10" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center">
          <Border x:Name="ModalIconCircle" Width="56" Height="56" CornerRadius="28" Background="#33F08A7A"
                  HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock x:Name="ModalIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                       Foreground="#F08A7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="ModalTitle" Text="Uygulamayı Kapat" FontSize="20" FontWeight="SemiBold"
                     Foreground="#FBF3E0" TextAlignment="Center" Margin="0,0,0,8"/>
          <TextBlock x:Name="ModalMessage" Text="Kütüphane Otomasyon Sistemini kapatmak istediğinize emin misiniz?"
                     FontSize="13" Foreground="#C9BFAE" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                     Margin="0,0,0,24" LineHeight="19"/>
          
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ModalCancelBtn" Content="Vazgeç" Width="130" Height="40" Margin="0,0,12,0"
                    Style="{StaticResource GlassButton}" Click="OnModalCancelClick"/>
            <Button x:Name="ModalConfirmBtn" Content="Evet, Kapat" Width="130" Height="40"
                    Style="{StaticResource GlassButton}" Click="OnModalConfirmClick"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Hızlı Ödünç & Onaylama Modal Layer -->
    <Grid x:Name="QuickLendHost" Visibility="Collapsed" Background="#B00D0704">
      <Border Width="500" VerticalAlignment="Center" HorizontalAlignment="Center"
              CornerRadius="22" Background="#F024180E" BorderBrush="#55FFFFFF" BorderThickness="1"
              Padding="28,24" ClipToBounds="True">
        <Border.Effect>
          <DropShadowEffect BlurRadius="45" ShadowDepth="8" Opacity="0.65"/>
        </Border.Effect>
        <StackPanel>
          <!-- Header -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Border Width="46" Height="46" CornerRadius="23" Background="#335FAE72" Margin="0,0,12,0">
              <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#8FD6A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Ödünç Verme &amp; Onaylama" FontSize="18" FontWeight="SemiBold" Foreground="#FBF3E0"/>
              <TextBlock Text="Üyeye anında kitap tahsisi yapın ve MariaDB'ye kaydedin." FontSize="12" Foreground="#C9BFAE" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>

          <!-- Member Select -->
          <TextBlock Text="Ödünç Alacak Üye" FontSize="12" FontWeight="SemiBold" Foreground="#EADFC8" Margin="0,0,0,6"/>
          <ComboBox x:Name="CmbLendMember" Height="36" Margin="0,0,0,14" Background="#281A11" Foreground="#1A0F08" FontSize="13" BorderBrush="#44FFFFFF"/>

          <!-- Book Select -->
          <TextBlock Text="Verilecek Kitap (Mevcut Stoktakiler)" FontSize="12" FontWeight="SemiBold" Foreground="#EADFC8" Margin="0,0,0,6"/>
          <ComboBox x:Name="CmbLendBook" Height="36" Margin="0,0,0,14" Background="#281A11" Foreground="#1A0F08" FontSize="13" BorderBrush="#44FFFFFF"/>

          <!-- Duration Select -->
          <TextBlock Text="Ödünç Süresi" FontSize="12" FontWeight="SemiBold" Foreground="#EADFC8" Margin="0,0,0,6"/>
          <ComboBox x:Name="CmbLendDuration" Height="36" Margin="0,0,0,22" Background="#281A11" Foreground="#1A0F08" FontSize="13" BorderBrush="#44FFFFFF">
            <ComboBoxItem Content="15 Gün (Standart Ödünç)" IsSelected="True"/>
            <ComboBoxItem Content="7 Gün (Kısa Süre)"/>
            <ComboBoxItem Content="30 Gün (Akademik Süre)"/>
          </ComboBox>

          <!-- Actions -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Vazgeç" Width="110" Height="38" Margin="0,0,12,0"
                    Style="{StaticResource GlassButton}" Click="OnCancelQuickLendClick"/>
            <Button Content="✓ Onayla ve Ödünç Ver" Width="185" Height="38"
                    Style="{StaticResource GlassButton}" Background="#3A7046" BorderBrush="#8FD6A0" Foreground="#FFFFFF"
                    FontWeight="SemiBold" Click="OnConfirmQuickLendClick"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Floating Glass Toast Notification -->
    <Border x:Name="ToastHost" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
            Margin="0,38,0,0" CornerRadius="18" Padding="20,10" Background="#EA22140B" BorderBrush="#556FBF7F"
            BorderThickness="1" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5"/>
      </Border.Effect>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="ToastIcon" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#7FD08F" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="ToastText" Text="İşlem başarılı" FontSize="13" FontWeight="SemiBold" Foreground="#F4EFE6" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>