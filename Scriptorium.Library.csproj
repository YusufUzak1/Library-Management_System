<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Scriptorium — Kütüphane Otomasyonu</ApplicationTitle>
    <AssemblyName>Scriptorium.Library</AssemblyName>
    <RootNamespace>Scriptorium</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LibraryManagement.Desktop\**" />
    <Page Remove="LibraryManagement.Desktop\**" />
    <Resource Remove="LibraryManagement.Desktop\**" />
    <None Remove="LibraryManagement.Desktop\**" />
    <Compile Remove="LibraryManagement.Application\**" />
    <Compile Remove="LibraryManagement.Domain\**" />
    <Compile Remove="LibraryManagement.Infrastructure\**" />
    <Compile Remove="LibraryManagement.Tests\**" />
  </ItemGroup>

</Project>
