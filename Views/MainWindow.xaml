<Window x:Class="Scriptorium.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Scriptorium.ViewModels"
        xmlns:sections="clr-namespace:Scriptorium.Views.Sections"
        Title="Scriptorium — Kurumsal Kütüphane Otomasyon Sistemi (.NET 8.0 / MariaDB)"
        Width="1440"
        Height="900"
        MinWidth="1220"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Surface.Canvas}"
        FontFamily="{StaticResource Font.Family.Sans}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NavigateCommand}" CommandParameter="Circulation" />
        <KeyBinding Key="F3" Command="{Binding NavigateCommand}" CommandParameter="Catalog" />
        <KeyBinding Key="F4" Command="{Binding NavigateCommand}" CommandParameter="Members" />
        <KeyBinding Key="F5" Command="{Binding NavigateCommand}" CommandParameter="Overdue" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleSidebarCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- ========================================================================= -->
        <!-- 1. AUTHENTICATED WORKSTATION SHELL                                        -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ==================== LEFT NAVIGATION SIDEBAR ==================== -->
                <Border Grid.Column="0"
                        Background="{StaticResource Brush.Surface.Sidebar}"
                        BorderBrush="#0D1411"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Brand Header -->
                        <Border Grid.Row="0" BorderBrush="#23332C" BorderThickness="0,0,0,1" Padding="14,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="4"
                                        Background="#23332C" BorderBrush="{StaticResource Brush.Accent.Secondary}" BorderThickness="1">
                                    <Path Data="{StaticResource Icon.BrandLogo}"
                                          Fill="{StaticResource Brush.Accent.Secondary}"
                                          Width="16" Height="16" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="SCRIPTORIUM"
                                               FontFamily="{StaticResource Font.Family.Serif}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Brush.Text.SidebarPrimary}" />
                                    <TextBlock Text="KÜTÜPHANE OTOMASYONU"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Accent.Secondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Navigation Menu Items -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8">
                            <StackPanel>
                                <!-- Group 1: Genel -->
                                <TextBlock Text="GENEL BAKIŞ"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#64756D"
                                           Margin="18,6,0,4"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />

                                <RadioButton Content="Genel Bakış (Dashboard)"
                                             Tag="{StaticResource Icon.Dashboard}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Dashboard}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Dashboard" />

                                <!-- Group 2: Koleksiyon -->
                                <TextBlock Text="KOLEKSİYON &amp; ENVANTER"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#64756D"
                                           Margin="18,14,0,4"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />

                                <RadioButton Content="Kitap Kataloğu"
                                             Tag="{StaticResource Icon.Catalog}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Catalog}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Catalog" />

                                <RadioButton Content="Yazarlar"
                                             Tag="{StaticResource Icon.Authors}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Authors}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Authors" />

                                <RadioButton Content="Kategoriler &amp; Raf"
                                             Tag="{StaticResource Icon.Categories}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Categories}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Categories" />

                                <RadioButton Content="Yayınevleri"
                                             Tag="{StaticResource Icon.Publishers}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Publishers}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Publishers" />

                                <!-- Group 3: Dolaşım ve Üye -->
                                <TextBlock Text="DOLAŞIM &amp; OKUYUCU"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#64756D"
                                           Margin="18,14,0,4"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />

                                <RadioButton Content="Ödünç Verme &amp; İade"
                                             Tag="{StaticResource Icon.Circulation}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Circulation}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Circulation" />

                                <RadioButton Content="Üye Yönetimi"
                                             Tag="{StaticResource Icon.Members}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Members}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Members" />

                                <RadioButton Content="Rezervasyonlar"
                                             Tag="{StaticResource Icon.Reservations}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Reservations}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Reservations" />

                                <RadioButton Content="Gecikmiş Kitaplar"
                                             Tag="{StaticResource Icon.Overdue}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Overdue}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Overdue" />

                                <!-- Group 4: Yönetim -->
                                <TextBlock Text="KURUMSAL YÖNETİM"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#64756D"
                                           Margin="18,14,0,4"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />

                                <RadioButton Content="Raporlar &amp; Analitik"
                                             Tag="{StaticResource Icon.Reports}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Reports}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Reports" />

                                <RadioButton Content="Personel &amp; Yetkiler"
                                             Tag="{StaticResource Icon.Users}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Users}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Users" />

                                <RadioButton Content="Sistem Ayarları"
                                             Tag="{StaticResource Icon.Settings}"
                                             Style="{StaticResource Nav.SidebarButton}"
                                             IsChecked="{Binding CurrentScreen, Converter={StaticResource ScreenBoolConverter}, ConverterParameter=Settings}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Settings" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Sidebar Footer: User Card & Logout -->
                        <Border Grid.Row="2" Background="{StaticResource Brush.Surface.SidebarDeep}" BorderBrush="#23332C" BorderThickness="0,1,0,0" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{StaticResource Brush.Accent.Secondary}">
                                    <TextBlock Text="{Binding CurrentUser.Initials}" FontSize="11" FontWeight="Bold" Foreground="#16211D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="{Binding CurrentUser.FullName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.SidebarPrimary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CurrentUser.Title}" FontSize="10.5" Foreground="{StaticResource Brush.Text.SidebarMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Command="{Binding LogoutCommand}"
                                        ToolTip="Vardiya Oturumunu Kapat"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Padding="4">
                                    <Path Data="{StaticResource Icon.Logout}" Fill="{StaticResource Brush.Text.SidebarMuted}" Width="15" Height="15" Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== RIGHT MAIN WORKSPACE AREA ==================== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TOP COMMAND HEADER -->
                    <Border Grid.Row="0" Background="{StaticResource Brush.Surface.Panel}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="22,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="310" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Breadcrumb & Page Title -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentBreadcrumbCategory}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Secondary}" />
                                    <TextBlock Text="  /  " FontSize="10" Foreground="{StaticResource Brush.Text.Muted}" />
                                    <TextBlock Text="{Binding CurrentPageSubtitle}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" />
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource Text.PageTitle}" Margin="0,1,0,0" />
                            </StackPanel>

                            <!-- Center: Global Search Input -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Input.TextBox}"
                                         Height="32"
                                         ToolTip="Herhangi bir ekrandayken kitap adı, ISBN, barkod veya üye arayın">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding ExecuteGlobalSearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2"
                                        Content="Hızlı Ara"
                                        Style="{StaticResource Button.Secondary}"
                                        Height="32"
                                        Command="{Binding ExecuteGlobalSearchCommand}" />
                            </Grid>

                            <!-- Right: Quick Actions & Alerts -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="⇄ Hızlı Ödünç / İade (F2)"
                                        Style="{StaticResource Button.Bronze}"
                                        Height="32"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Circulation"
                                        Margin="0,0,8,0" />

                                <Button Style="{StaticResource Button.Danger}"
                                        Height="32"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Overdue"
                                        ToolTip="Gecikmiş kitapları görüntüle">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Bell}" Fill="{StaticResource Brush.Status.DangerText}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding OverdueBooksCount, StringFormat='Gecikmiş: {0}'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- NON-BLOCKING TOAST NOTIFICATION BANNER -->
                    <Border Grid.Row="1"
                            Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                            Background="{Binding ToastKind, Converter={StaticResource StatusBgConverter}}"
                            BorderBrush="{Binding ToastKind, Converter={StaticResource StatusBorderConverter}}"
                            BorderThickness="0,0,0,1"
                            Padding="22,8">
                        <DockPanel>
                            <TextBlock Text="{Binding ToastMessage}"
                                       Foreground="{Binding ToastKind, Converter={StaticResource StatusFgConverter}}"
                                       FontWeight="SemiBold"
                                       FontSize="12.5"
                                       VerticalAlignment="Center" />
                            <Button Content="✕ Kapat"
                                    Command="{Binding DismissToastCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{Binding ToastKind, Converter={StaticResource StatusFgConverter}}"
                                    FontSize="11.5"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Right"
                                    Cursor="Hand" />
                        </DockPanel>
                    </Border>

                    <!-- MAIN SCREEN CONTENT SWITCHER -->
                    <Grid Grid.Row="2" Margin="20,16">
                        <sections:DashboardSection Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Dashboard}" />
                        <sections:CatalogSection Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Catalog}" />
                        <sections:CirculationSection Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Circulation}" />
                        <sections:MembersSection Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Members}" />
                        <sections:CollectionMetaSection />
                        <sections:OperationsAndAdminSection />
                    </Grid>
                </Grid>
            </Grid>

            <!-- ==================== BOTTOM WORKSTATION STATUS BAR ==================== -->
            <Border Grid.Row="1"
                    Background="{StaticResource Brush.Surface.Subtle}"
                    BorderBrush="{StaticResource Brush.Border.Default}"
                    BorderThickness="0,1,0,0"
                    Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- MariaDB Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#1B5E3A" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionStatusText}" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <!-- Keyboard Shortcut Hints -->
                    <TextBlock Grid.Column="1"
                               Text="[F2] Ödünç &amp; İade Bankosu    [F3] Kitap Kataloğu    [F4] Üyeler    [F5] Gecikmiş Kitaplar    [Ctrl+B] Yan Menü"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               HorizontalAlignment="Center" />

                    <!-- Active Circulation Policy Summary -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding RulesSummaryStatusText}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 2. SCREEN A: MINIMAL, SOPHISTICATED LOGIN SCREEN OVERLAY                  -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVis}}"
              Background="{StaticResource Brush.Surface.Canvas}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.44*" />
                <ColumnDefinition Width="0.56*" />
            </Grid.ColumnDefinitions>

            <!-- Left Editorial Branding Panel (Deep Obsidian Pine) -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Surface.Sidebar}" Padding="48,44">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Crest -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="6"
                                Background="#23332C" BorderBrush="{StaticResource Brush.Accent.Secondary}" BorderThickness="1.5">
                            <Path Data="{StaticResource Icon.BrandLogo}"
                                  Fill="{StaticResource Brush.Accent.Secondary}"
                                  Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SCRIPTORIUM"
                                       FontFamily="{StaticResource Font.Family.Serif}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.SidebarPrimary}" />
                            <TextBlock Text="KURUMSAL KÜTÜPHANE VE ARŞİV OTOMASYONU"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Accent.Secondary}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Editorial Centerpiece Quote -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Rectangle Width="48" Height="2" Fill="{StaticResource Brush.Accent.Secondary}" HorizontalAlignment="Left" Margin="0,0,0,20" />
                        <TextBlock Text="“Ben cenneti hep bir tür kütüphane olarak hayal etmişimdir; zamanın, hafızanın ve düşüncenin sessizce korunduğu bir sığınak.”"
                                   FontFamily="{StaticResource Font.Family.Serif}"
                                   FontSize="22"
                                   Foreground="{StaticResource Brush.Text.SidebarPrimary}"
                                   TextWrapping="Wrap"
                                   LineHeight="32"
                                   Margin="0,0,0,16" />
                        <TextBlock Text="— JORGE LUIS BORGES • MERKEZ KOLEKSİYON VE DOLAŞIM SİSTEMİ"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.SidebarMuted}" />
                    </StackPanel>

                    <!-- Database & System Status Footer -->
                    <Border Grid.Row="2" Background="#1F2E28" BorderBrush="#2D4239" BorderThickness="1" CornerRadius="4" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="VERİTABANI VE ENVANTER DURUMU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Secondary}" />
                            <TextBlock Text="{Binding ConnectionStatusText}" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11.5" Foreground="{StaticResource Brush.Text.SidebarPrimary}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Login Form Panel -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Surface.Canvas}">
                <Border Style="{StaticResource Panel.Section}"
                        Width="430"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="36,34">
                    <StackPanel>
                        <TextBlock Text="Personel Oturumu Açın"
                                   FontFamily="{StaticResource Font.Family.Serif}"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Primary}" />
                        <TextBlock Text="Katalog, ödünç/iade bankosu ve üye işlemlerine erişmek için kurumsal kimlik bilgilerinizi girin."
                                   FontSize="12.5"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,22" />

                        <TextBlock Text="Personel Kullanıcı Adı" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Input.TextBox}"
                                 FontFamily="{StaticResource Font.Family.Mono}"
                                 Height="38"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="Parola" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Input.TextBox}"
                                 FontFamily="{StaticResource Font.Family.Mono}"
                                 Height="38"
                                 Margin="0,0,0,16">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding LoginCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Validation Error Message -->
                        <TextBlock Text="{Binding LoginErrorMessage}"
                                   Foreground="{StaticResource Brush.Status.DangerText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <Button Content="Vardiya Oturumunu Başlat →"
                                Style="{StaticResource Button.Primary}"
                                Height="40"
                                FontSize="13.5"
                                Command="{Binding LoginCommand}"
                                Margin="0,0,0,18" />

                        <!-- Demo Credentials Info Box -->
                        <Border Style="{StaticResource Panel.SubtleWell}" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="HAZIR YETKİLİ HESAPLARI (HIZLI GİRİŞ)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                                <TextBlock FontFamily="{StaticResource Font.Family.Mono}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Primary}">
                                    <Run Text="• Baş Kütüphaneci: " Foreground="{StaticResource Brush.Text.Secondary}" /><Run Text="admin" FontWeight="Bold" /><Run Text=" / Parola: " Foreground="{StaticResource Brush.Text.Secondary}" /><Run Text="1234" FontWeight="Bold" />
                                </TextBlock>
                                <TextBlock FontFamily="{StaticResource Font.Family.Mono}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,2,0,0">
                                    <Run Text="• Okuyucu Hizmetleri: " Foreground="{StaticResource Brush.Text.Secondary}" /><Run Text="kutuphaneci" FontWeight="Bold" /><Run Text=" / Parola: " Foreground="{StaticResource Brush.Text.Secondary}" /><Run Text="1234" FontWeight="Bold" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
