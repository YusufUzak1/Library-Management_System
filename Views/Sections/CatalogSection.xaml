<UserControl x:Class="Scriptorium.Views.Sections.CatalogSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. FILTER, SEARCH & CATALOG COMMAND BAR ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Panel.Section}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input.TextBox}"
                             Padding="30,0,10,0"
                             ToolTip="Kitap adı, yazar, ISBN-13, barkod veya raf konumuna göre anlık filtreleme" />
                    <Path Data="{StaticResource Icon.Search}"
                          Fill="{StaticResource Brush.Text.Muted}"
                          Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="11,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Kitap adı, yazar, ISBN, barkod veya raf ara..."
                               Foreground="{StaticResource Brush.Text.Muted}"
                               FontSize="12.5"
                               VerticalAlignment="Center"
                               Margin="32,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CatalogSearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Category Filter -->
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding CategoryFilterOptions}"
                          SelectedItem="{Binding SelectedCategoryFilter}"
                          Style="{StaticResource Input.ComboBox}"
                          ToolTip="Kategori filtresi" />

                <!-- Publisher Filter -->
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding PublisherFilterOptions}"
                          SelectedItem="{Binding SelectedPublisherFilter}"
                          Style="{StaticResource Input.ComboBox}"
                          ToolTip="Yayınevi filtresi" />

                <!-- Availability Filter -->
                <ComboBox Grid.Column="6"
                          ItemsSource="{Binding AvailabilityFilterOptions}"
                          SelectedItem="{Binding SelectedAvailabilityFilter}"
                          Style="{StaticResource Input.ComboBox}"
                          ToolTip="Stok ve erişilebilirlik durumu" />

                <!-- Sort Selector -->
                <ComboBox Grid.Column="8"
                          ItemsSource="{Binding SortCatalogOptions}"
                          SelectedItem="{Binding SelectedCatalogSort}"
                          Style="{StaticResource Input.ComboBox}"
                          ToolTip="Katalog sıralama ölçütü" />

                <!-- Reset Filters -->
                <Button Grid.Column="10"
                        Content="Sıfırla"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding ResetCatalogFiltersCommand}" />

                <!-- New Book CTA -->
                <Button Grid.Column="12"
                        Content="+ Yeni Kitap Ekle"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding StartNewBookCommand}" />
            </Grid>
        </Border>

        <!-- ==================== 2. MASTER CATALOG TABLE + RIGHT BOOK DOSSIER INSPECTOR ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="405" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: HIGH-DENSITY CATALOG DATAGRID -->
            <Border Grid.Column="0" Style="{StaticResource Panel.Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding FilteredBooks}"
                              SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                              Style="{StaticResource Grid.Archival}"
                              BorderThickness="0"
                              RowHeight="50">
                        <DataGrid.Columns>
                            <!-- Cover Thumbnail -->
                            <DataGridTemplateColumn Header="KAPAK" Width="54">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="28" Height="38" CornerRadius="2"
                                                Background="{Binding CoverHex, Converter={StaticResource HexToBrushConverter}}"
                                                BorderBrush="#33000000" BorderThickness="1"
                                                HorizontalAlignment="Center">
                                            <Grid>
                                                <Rectangle Width="2" Fill="#28FFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0" />
                                                <TextBlock Text="{Binding CoverInitials}"
                                                           FontFamily="{StaticResource Font.Family.Serif}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#F6F4EF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Book Title & Author -->
                            <DataGridTemplateColumn Header="ESER ADI VE YAZAR" Width="2.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding AuthorName, Mode=OneWay}" FontWeight="Medium" />
                                                <Run Text=" • " Foreground="{StaticResource Brush.Text.Muted}" />
                                                <Run Text="{Binding PublisherName, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ISBN & Barcode -->
                            <DataGridTemplateColumn Header="ISBN-13 / BARKOD" Width="138">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Isbn}" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Primary}" />
                                            <TextBlock Text="{Binding Barcode}" FontFamily="{StaticResource Font.Family.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.Text.Muted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Category -->
                            <DataGridTemplateColumn Header="KATEGORİ / DEWEY" Width="1.25*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CategoryName}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DeweyCode, StringFormat='Dewey: {0}'}" FontFamily="{StaticResource Font.Family.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.Text.Muted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Publication Year -->
                            <DataGridTextColumn Header="YIL" Binding="{Binding PublicationYear, Mode=OneWay}" Width="62" FontFamily="{StaticResource Font.Family.Mono}" FontSize="12" />

                            <!-- Shelf Location -->
                            <DataGridTemplateColumn Header="RAF KONUMU" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Brush.Surface.Subtle}"
                                                BorderBrush="{StaticResource Brush.Border.Default}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="6,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ShelfLocation}" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11.5" FontWeight="Medium" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Stock / Available Ratio -->
                            <DataGridTemplateColumn Header="MEVCUT / STOK" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding InventoryRatioText}" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding TotalBorrowCount, StringFormat='{}{0} kez ödünç'}" FontSize="10.5" Foreground="{StaticResource Brush.Text.Muted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="DURUM" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusKind, Converter={StaticResource StatusBgConverter}}"
                                                BorderBrush="{Binding StatusKind, Converter={StaticResource StatusBorderConverter}}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="7,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding AvailabilityStatus}"
                                                       Foreground="{Binding StatusKind, Converter={StaticResource StatusFgConverter}}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Quick Issue Action -->
                            <DataGridTemplateColumn Header="İŞLEM" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Ödünç Ver"
                                                Style="{StaticResource Button.Compact}"
                                                Command="{Binding DataContext.QuickIssueSelectedBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsAvailable}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Catalog Footer Bar -->
                    <Border Grid.Row="1" Background="{StaticResource Brush.Surface.Subtle}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="14,0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}">
                                <Run Text="Gösterilen Eser: " />
                                <Run Text="{Binding FilteredBooks.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                                <Run Text=" / Toplam " />
                                <Run Text="{Binding TotalTitlesCount, Mode=OneWay}" />
                                <Run Text=" Başlık (" />
                                <Run Text="{Binding TotalPhysicalCopiesCount, Mode=OneWay}" />
                                <Run Text=" Fiziksel Nüsha)" />
                            </TextBlock>
                            <TextBlock Text="Satıra tıklayarak sağ panelde eser künyesini inceleyebilir veya düzenleyebilirsiniz."
                                       FontSize="11.5"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== RIGHT: BOOK DETAILS & EDITING INSPECTOR (SCREEN D) ==================== -->
            <Border Grid.Column="2" Style="{StaticResource Panel.Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Book Header Banner -->
                    <Border Grid.Row="0" Background="{StaticResource Brush.Surface.Subtle}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Large Editorial Book Cover -->
                            <Border Grid.Column="0" Width="68" Height="94" CornerRadius="3"
                                    Background="{Binding SelectedBook.CoverHex, Converter={StaticResource HexToBrushConverter}}"
                                    BorderBrush="#33000000" BorderThickness="1">
                                <Grid>
                                    <Rectangle Width="4" Fill="#26FFFFFF" HorizontalAlignment="Left" Margin="4,0,0,0" />
                                    <Border BorderBrush="#40FFFFFF" BorderThickness="1" Margin="8,8,6,8" Padding="4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedBook.CoverInitials}"
                                                       FontFamily="{StaticResource Font.Family.Serif}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#F6F4EF"
                                                       HorizontalAlignment="Center" />
                                            <Rectangle Height="1" Fill="#66B08342" Margin="4,4" />
                                            <TextBlock Text="{Binding SelectedBook.PublicationYear}"
                                                       FontFamily="{StaticResource Font.Family.Mono}"
                                                       FontSize="9.5"
                                                       Foreground="#D8D4CC"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Title, Author & Status -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedBook.Title, FallbackValue='Kitap Seçilmedi'}"
                                           FontFamily="{StaticResource Font.Family.Serif}"
                                           FontWeight="SemiBold"
                                           FontSize="16"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedBook.Subtitle}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SelectedBook.AuthorName}"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"
                                           Foreground="{StaticResource Brush.Accent.Primary}"
                                           Margin="0,5,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{Binding SelectedBook.StatusKind, Converter={StaticResource StatusBgConverter}}"
                                            BorderBrush="{Binding SelectedBook.StatusKind, Converter={StaticResource StatusBorderConverter}}"
                                            BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedBook.AvailabilityStatus}"
                                                   Foreground="{Binding SelectedBook.StatusKind, Converter={StaticResource StatusFgConverter}}"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#FFFFFF" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="3" Padding="7,2">
                                        <TextBlock Text="{Binding SelectedBook.ShelfLocation, StringFormat='Raf: {0}'}"
                                                   FontFamily="{StaticResource Font.Family.Mono}"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Inspector Sub-Navigation Tabs -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="1. Künye &amp; Envanter"
                                    Style="{StaticResource Button.Compact}"
                                    Command="{Binding SelectBookInspectorTabCommand}"
                                    CommandParameter="Kunye"
                                    Margin="0,0,6,0" />
                            <Button Content="2. Ödünç Geçmişi"
                                    Style="{StaticResource Button.Compact}"
                                    Command="{Binding SelectBookInspectorTabCommand}"
                                    CommandParameter="Gecmis"
                                    Margin="0,0,6,0" />
                            <Button Content="3. Ekle / Düzenle"
                                    Style="{StaticResource Button.Compact}"
                                    Command="{Binding SelectBookInspectorTabCommand}"
                                    CommandParameter="Duzenle" />
                        </StackPanel>
                    </Border>

                    <!-- TAB 1: BIBLIOGRAPHIC & INVENTORY DOSSIER -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding BookInspectorTab, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Kunye}">
                        <StackPanel Margin="16,14">
                            <!-- Inventory Summary Strip -->
                            <Border Style="{StaticResource Panel.SubtleWell}" Padding="12,10" Margin="0,0,0,14">
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="TOPLAM NÜSHA" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" />
                                        <TextBlock Text="{Binding SelectedBook.TotalCopies}" FontFamily="{StaticResource Font.Family.Serif}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="RAFTA MEVCUT" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.SuccessText}" />
                                        <TextBlock Text="{Binding SelectedBook.AvailableCopies}" FontFamily="{StaticResource Font.Family.Serif}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.SuccessText}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ÖDÜNÇTE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.InfoText}" />
                                        <TextBlock Text="{Binding SelectedBook.BorrowedCopies}" FontFamily="{StaticResource Font.Family.Serif}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.InfoText}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <TextBlock Text="BİBLİYOGRAFİK KÜNYE BİLGİLERİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ISBN-13:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedBook.Isbn}" FontFamily="{StaticResource Font.Family.Mono}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Demirbaş Barkod:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBook.Barcode}" FontFamily="{StaticResource Font.Family.Mono}" FontSize="12" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Yayınevi:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedBook.PublisherName}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Kategori / Dewey:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" VerticalAlignment="Center">
                                    <Run Text="{Binding SelectedBook.CategoryName, Mode=OneWay}" />
                                    <Run Text=" (" /><Run Text="{Binding SelectedBook.DeweyCode, Mode=OneWay}" FontFamily="{StaticResource Font.Family.Mono}" /><Run Text=")" />
                                </TextBlock>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Basım Yılı / Baskı:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12" VerticalAlignment="Center">
                                    <Run Text="{Binding SelectedBook.PublicationYear, Mode=OneWay}" FontFamily="{StaticResource Font.Family.Mono}" />
                                    <Run Text=" • " />
                                    <Run Text="{Binding SelectedBook.Edition, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Sayfa / Dil:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12" VerticalAlignment="Center">
                                    <Run Text="{Binding SelectedBook.PageCount, Mode=OneWay}" FontFamily="{StaticResource Font.Family.Mono}" />
                                    <Run Text=" Sayfa • " />
                                    <Run Text="{Binding SelectedBook.Language, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Fiziksel Kondisyon:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedBook.PhysicalCondition}" FontSize="12" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Toplam Dolaşım:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedBook.TotalBorrowCount, StringFormat='{}{0} kez ödünç verildi'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Secondary}" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="ESER ÖZETİ VE KATALOG NOTU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,6" />
                            <Border Style="{StaticResource Panel.SubtleWell}" Padding="10,8" Margin="0,0,0,16">
                                <TextBlock Text="{Binding SelectedBook.Summary}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap" LineHeight="18" />
                            </Border>

                            <!-- Quick Actions -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Ödünç Bankosuna Aktar"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding QuickIssueSelectedBookCommand}" />
                                <Button Grid.Column="2"
                                        Content="Düzenle"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding SelectBookInspectorTabCommand}"
                                        CommandParameter="Duzenle" />
                                <Button Grid.Column="4"
                                        Content="Sil"
                                        Style="{StaticResource Button.Danger}"
                                        Command="{Binding DeleteSelectedBookCommand}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 2: BORROWING HISTORY FOR THIS BOOK -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding BookInspectorTab, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Gecmis}">
                        <DataGrid ItemsSource="{Binding SelectedBookLoanHistory}"
                                  Style="{StaticResource Grid.Archival}"
                                  BorderThickness="0"
                                  RowHeight="42">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="OKUR / ÜYE" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding MemberName}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{Binding MemberNumber}" FontFamily="{StaticResource Font.Family.Mono}" FontSize="10.5" Foreground="{StaticResource Brush.Text.Muted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="VERİLİŞ" Binding="{Binding BorrowDateText, Mode=OneWay}" Width="82" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11" />
                                <DataGridTextColumn Header="DURUM" Binding="{Binding DueStatusLabel, Mode=OneWay}" Width="115" FontSize="11.5" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- TAB 3: ADD / EDIT BOOK FORM -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding BookInspectorTab, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Duzenle}">
                        <StackPanel Margin="16,12">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="KİTAP KÜNYE VE STOK FORMU" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Primary}" VerticalAlignment="Center" />
                                <Button Content="+ Boş Form Aç"
                                        Style="{StaticResource Button.Compact}"
                                        Command="{Binding StartNewBookCommand}"
                                        HorizontalAlignment="Right" />
                            </DockPanel>

                            <TextBlock Text="Eser Başlığı *" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableBook.Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,10" />

                            <TextBlock Text="Alt Başlık / Dizi Adı" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableBook.Subtitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ISBN-13 *" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding EditableBook.Isbn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Demirbaş Barkodu *" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding EditableBook.Barcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Yazar *" Style="{StaticResource Text.Label}" />
                            <ComboBox ItemsSource="{Binding AuthorsList}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="FullName"
                                      SelectedValue="{Binding EditableBook.AuthorId}"
                                      Style="{StaticResource Input.ComboBox}"
                                      Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Kategori *" Style="{StaticResource Text.Label}" />
                                    <ComboBox ItemsSource="{Binding CategoriesList}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              SelectedValue="{Binding EditableBook.CategoryId}"
                                              Style="{StaticResource Input.ComboBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Yayınevi *" Style="{StaticResource Text.Label}" />
                                    <ComboBox ItemsSource="{Binding PublishersList}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              SelectedValue="{Binding EditableBook.PublisherId}"
                                              Style="{StaticResource Input.ComboBox}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Basım Yılı" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding EditableBook.PublicationYear}" Style="{StaticResource Input.TextBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sayfa Sayısı" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding EditableBook.PageCount}" Style="{StaticResource Input.TextBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Raf Konumu" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding EditableBook.ShelfLocation}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Toplam Nüsha Adedi" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding EditableBook.TotalCopies}" Style="{StaticResource Input.TextBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Rafta Mevcut Nüsha" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding EditableBook.AvailableCopies}" Style="{StaticResource Input.TextBox}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Eser Özeti / Katalog Notu" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableBook.Summary, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}"
                                     Height="64"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Padding="8,6"
                                     Margin="0,0,0,14" />

                            <Button Content="✓ Kitap Kaydını Veritabanına Kaydet"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding SaveBookCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

