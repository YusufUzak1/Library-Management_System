<UserControl x:Class="Scriptorium.Views.Sections.MembersSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. MEMBER SEARCH & FILTER BAR ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Panel.Section}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Text="{Binding MemberSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input.TextBox}"
                             Padding="30,0,10,0" />
                    <Path Data="{StaticResource Icon.Search}"
                          Fill="{StaticResource Brush.Text.Muted}"
                          Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="11,0,0,0" IsHitTestVisible="False" />
                </Grid>

                <ComboBox Grid.Column="2"
                          SelectedItem="{Binding SelectedMemberStatusFilter}"
                          Style="{StaticResource Input.ComboBox}">
                    <ComboBox.ItemsSource>
                        <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <sys:String>Tüm Üyeler</sys:String>
                            <sys:String>Aktif Üyeler</sys:String>
                            <sys:String>Gecikmesi Olanlar</sys:String>
                            <sys:String>Askıdaki Üyeler</sys:String>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>

                <Button Grid.Column="4"
                        Content="+ Yeni Üye Kaydı"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding StartNewMemberCommand}" />
            </Grid>
        </Border>

        <!-- ==================== 2. MASTER MEMBERS DIRECTORY + RIGHT MEMBER DOSSIER ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: MEMBERS DATAGRID -->
            <Border Grid.Column="0" Style="{StaticResource Panel.Section}">
                <DataGrid ItemsSource="{Binding FilteredMembers}"
                          SelectedItem="{Binding SelectedMember, Mode=TwoWay}"
                          Style="{StaticResource Grid.Archival}"
                          BorderThickness="0"
                          RowHeight="48">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ÜYE NUMARASI" Binding="{Binding MemberNumber, Mode=OneWay}" Width="125" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="SemiBold" FontSize="12" />
                        <DataGridTemplateColumn Header="AD SOYAD VE KURUM / BÖLÜM" Width="1.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding DepartmentOrInstitution}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ÜYE TÜRÜ" Binding="{Binding MemberType, Mode=OneWay}" Width="135" FontSize="12" />
                        <DataGridTemplateColumn Header="İLETİŞİM" Width="1.35*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Email}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Phone}" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="KAYIT TARİHİ" Binding="{Binding RegistrationDateText, Mode=OneWay}" Width="98" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11.5" />
                        <DataGridTextColumn Header="ÖDÜNÇTE" Binding="{Binding QuotaRatioText, Mode=OneWay}" Width="82" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="SemiBold" FontSize="12" />
                        <DataGridTemplateColumn Header="ÜYELİK DURUMU" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusKind, Converter={StaticResource StatusBgConverter}}"
                                            BorderBrush="{Binding StatusKind, Converter={StaticResource StatusBorderConverter}}"
                                            BorderThickness="1" CornerRadius="3" Padding="7,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusFgConverter}}"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="BANKO" Width="92">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Ödünç Ver"
                                            Style="{StaticResource Button.Compact}"
                                            Command="{Binding DataContext.OpenMemberInCirculationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT: MEMBER DOSSIER, ACTIVE LOANS, HISTORY & EDITING -->
            <Border Grid.Column="2" Style="{StaticResource Panel.Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Member Header Card -->
                    <Border Grid.Row="0" Background="{StaticResource Brush.Surface.Subtle}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                    Background="{StaticResource Brush.Accent.Primary}">
                                <TextBlock Text="{Binding SelectedMember.Initials}"
                                           FontFamily="{StaticResource Font.Family.Serif}"
                                           FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedMember.FullName, FallbackValue='Üye Seçilmedi'}"
                                           FontFamily="{StaticResource Font.Family.Serif}"
                                           FontSize="16" FontWeight="SemiBold" />
                                <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,4">
                                    <Run Text="{Binding SelectedMember.MemberNumber, Mode=OneWay}" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="SemiBold" />
                                    <Run Text=" • " />
                                    <Run Text="{Binding SelectedMember.MemberType, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedMember.DepartmentOrInstitution}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sub-tabs -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="1. Profil &amp; Ödünçteki"
                                    Style="{StaticResource Button.Compact}"
                                    Command="{Binding SelectMemberInspectorTabCommand}"
                                    CommandParameter="Profil"
                                    Margin="0,0,6,0" />
                            <Button Content="2. Tüm Geçmiş"
                                    Style="{StaticResource Button.Compact}"
                                    Command="{Binding SelectMemberInspectorTabCommand}"
                                    CommandParameter="Odunc"
                                    Margin="0,0,6,0" />
                            <Button Content="3. Ekle / Düzenle"
                                    Style="{StaticResource Button.Compact}"
                                    Command="{Binding SelectMemberInspectorTabCommand}"
                                    CommandParameter="Duzenle" />
                        </StackPanel>
                    </Border>

                    <!-- TAB 1: MEMBER PROFILE & CURRENTLY BORROWED BOOKS -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding MemberInspectorTab, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Profil}">
                        <StackPanel Margin="16,14">
                            <Border Style="{StaticResource Panel.SubtleWell}" Padding="12,10" Margin="0,0,0,14">
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="AKTİF ÖDÜNÇ" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" />
                                        <TextBlock Text="{Binding SelectedMember.QuotaRatioText}" FontFamily="{StaticResource Font.Family.Serif}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="TOPLAM OKUNAN" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" />
                                        <TextBlock Text="{Binding SelectedMember.TotalBorrowedCount}" FontFamily="{StaticResource Font.Family.Serif}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="CEZA BAKİYESİ" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.DangerText}" />
                                        <TextBlock Text="{Binding SelectedMember.FineBalanceText}" FontFamily="{StaticResource Font.Family.Serif}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.DangerText}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <TextBlock Text="İLETİŞİM VE KİMLİK BİLGİLERİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                            <TextBlock FontSize="12" Margin="0,0,0,3"><Run Text="T.C. Kimlik No: " Foreground="{StaticResource Brush.Text.Secondary}" /><Run Text="{Binding SelectedMember.IdentityNumber, Mode=OneWay}" FontFamily="{StaticResource Font.Family.Mono}" /></TextBlock>
                            <TextBlock FontSize="12" Margin="0,0,0,3"><Run Text="E-Posta: " Foreground="{StaticResource Brush.Text.Secondary}" /><Run Text="{Binding SelectedMember.Email, Mode=OneWay}" /></TextBlock>
                            <TextBlock FontSize="12" Margin="0,0,0,3"><Run Text="Telefon: " Foreground="{StaticResource Brush.Text.Secondary}" /><Run Text="{Binding SelectedMember.Phone, Mode=OneWay}" FontFamily="{StaticResource Font.Family.Mono}" /></TextBlock>
                            <TextBlock FontSize="12" Margin="0,0,0,3" TextWrapping="Wrap"><Run Text="Adres: " Foreground="{StaticResource Brush.Text.Secondary}" /><Run Text="{Binding SelectedMember.Address, Mode=OneWay}" /></TextBlock>
                            <TextBlock FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"><Run Text="Not: " Foreground="{StaticResource Brush.Text.Secondary}" /><Run Text="{Binding SelectedMember.Notes, Mode=OneWay}" /></TextBlock>

                            <TextBlock Text="ÜZERİNDEKİ AKTİF KİTAPLAR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedMemberActiveLoans}" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Panel.SubtleWell}" Padding="10,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding BookTitle}" FontWeight="SemiBold" FontSize="12.5" />
                                                    <TextBlock FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}">
                                                        <Run Text="Son Teslim: " />
                                                        <Run Text="{Binding DueDateText, Mode=OneWay}" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="SemiBold" />
                                                        <Run Text=" • " />
                                                        <Run Text="{Binding DueStatusLabel, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Content="İade Al"
                                                        Style="{StaticResource Button.CompactPrimary}"
                                                        Command="{Binding DataContext.ProcessReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Bankoda Bu Üyeye Kitap Ödünç Ver →"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding OpenMemberInCirculationCommand}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 2: MEMBER FULL LOAN HISTORY -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SelectedMemberHistory}"
                              Style="{StaticResource Grid.Archival}"
                              BorderThickness="0"
                              RowHeight="42"
                              Visibility="{Binding MemberInspectorTab, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Odunc}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KİTAP ADI" Binding="{Binding BookTitle, Mode=OneWay}" Width="*" FontSize="12" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="VERİLİŞ" Binding="{Binding BorrowDateText, Mode=OneWay}" Width="82" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11" />
                            <DataGridTextColumn Header="DURUM" Binding="{Binding DueStatusLabel, Mode=OneWay}" Width="115" FontSize="11" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- TAB 3: ADD / EDIT MEMBER FORM -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding MemberInspectorTab, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Duzenle}">
                        <StackPanel Margin="16,12">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="ÜYE KAYIT VE DÜZENLEME FORMU" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Primary}" VerticalAlignment="Center" />
                                <Button Content="+ Yeni Üye Formu"
                                        Style="{StaticResource Button.Compact}"
                                        Command="{Binding StartNewMemberCommand}"
                                        HorizontalAlignment="Right" />
                            </DockPanel>

                            <TextBlock Text="Üye Numarası *" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableMember.MemberNumber}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" Margin="0,0,0,8" />

                            <TextBlock Text="Ad Soyad *" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableMember.FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="T.C. Kimlik No" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding EditableMember.IdentityNumber}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Üye Grubu" Style="{StaticResource Text.Label}" />
                                    <ComboBox ItemsSource="{Binding MemberTypeOptions}" SelectedItem="{Binding EditableMember.MemberType}" Style="{StaticResource Input.ComboBox}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Telefon" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding EditableMember.Phone}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="E-Posta" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding EditableMember.Email}" Style="{StaticResource Input.TextBox}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Fakülte / Kurum / Bölüm" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableMember.DepartmentOrInstitution}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Üyelik Durumu" Style="{StaticResource Text.Label}" />
                                    <ComboBox ItemsSource="{Binding MemberStatusOptions}" SelectedItem="{Binding EditableMember.Status}" Style="{StaticResource Input.ComboBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Maksimum Kitap Kotası" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding EditableMember.MaxLoanLimit}" Style="{StaticResource Input.TextBox}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Adres ve Notlar" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableMember.Notes}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,12" />

                            <Button Content="✓ Üye Bilgilerini Kaydet"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding SaveMemberCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

