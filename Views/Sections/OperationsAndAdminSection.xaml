<UserControl x:Class="Scriptorium.Views.Sections.OperationsAndAdminSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>

        <!-- ==================== SCREEN G: RESERVATIONS ==================== -->
        <Grid Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Reservations}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="375" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel.Section}">
                <DataGrid ItemsSource="{Binding ReservationsList}"
                          SelectedItem="{Binding SelectedReservation, Mode=TwoWay}"
                          Style="{StaticResource Grid.Archival}"
                          BorderThickness="0"
                          RowHeight="50">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SIRA" Binding="{Binding QueueText, Mode=OneWay}" Width="72" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="Bold" FontSize="12" />
                        <DataGridTextColumn Header="KOD" Binding="{Binding ReservationCode, Mode=OneWay}" Width="118" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11.5" />
                        <DataGridTemplateColumn Header="REZERVE EDİLEN ESER" Width="1.7*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding BookTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}">
                                            <Run Text="{Binding BookAuthor, Mode=OneWay}" />
                                            <Run Text=" • Raf: " />
                                            <Run Text="{Binding ShelfLocation, Mode=OneWay}" FontFamily="{StaticResource Font.Family.Mono}" />
                                            <Run Text=" (Mevcut: " /><Run Text="{Binding AvailableCopies, Mode=OneWay}" FontWeight="Bold" /><Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TALEP EDEN ÜYE" Width="1.35*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding MemberName}" FontWeight="Medium" FontSize="12.5" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" FontFamily="{StaticResource Font.Family.Mono}">
                                            <Run Text="{Binding MemberNumber, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding MemberPhone, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="TALEP TARİHİ" Binding="{Binding ReservationDateText, Mode=OneWay}" Width="115" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11" />
                        <DataGridTemplateColumn Header="DURUM" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusKind, Converter={StaticResource StatusBgConverter}}"
                                            BorderBrush="{Binding StatusKind, Converter={StaticResource StatusBorderConverter}}"
                                            BorderThickness="1" CornerRadius="3" Padding="7,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusFgConverter}}"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="İŞLEMLER" Width="215">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="✓ Ödünç Ver"
                                                Style="{StaticResource Button.CompactPrimary}"
                                                Command="{Binding DataContext.FulfillReservationToLoanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,5,0" />
                                        <Button Content="Rafa Ayır"
                                                Style="{StaticResource Button.Compact}"
                                                Command="{Binding DataContext.MarkReservationReadyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,5,0" />
                                        <Button Content="İptal"
                                                Style="{StaticResource Button.CompactDanger}"
                                                Command="{Binding DataContext.CancelReservationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right Panel: New Reservation Form -->
            <Border Grid.Column="2" Style="{StaticResource Panel.Section}" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="YENİ REZERVASYON KAYDI OLUŞTUR" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Primary}" Margin="0,0,0,6" />
                    <TextBlock Text="Ödünçte olan veya okur adına banko rezerv rafında ayrılacak kitaplar için sıra kaydı oluşturun."
                               FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <TextBlock Text="Talep Eden Üye *" Style="{StaticResource Text.Label}" />
                    <ComboBox ItemsSource="{Binding FilteredMembers}"
                              SelectedItem="{Binding NewReservationMember, Mode=TwoWay}"
                              DisplayMemberPath="FullName"
                              Style="{StaticResource Input.ComboBox}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Rezerve Edilecek Eser *" Style="{StaticResource Text.Label}" />
                    <ComboBox ItemsSource="{Binding FilteredBooks}"
                              SelectedItem="{Binding NewReservationBook, Mode=TwoWay}"
                              DisplayMemberPath="Title"
                              Style="{StaticResource Input.ComboBox}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Rezervasyon Notu" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding NewReservationNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input.TextBox}"
                             Margin="0,0,0,16" />

                    <Button Content="+ Rezervasyon Sırasına Ekle"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding CreateReservationCommand}" />

                    <Border Style="{StaticResource Panel.SubtleWell}" Padding="12,10" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="REZERVASYON İŞLEYİŞ KURALI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,4" />
                            <TextBlock Text="Ödünçteki bir kitap iade alındığında sistem otomatik olarak 1. sıradaki rezervasyonu 'Rafta Ayrıldı' durumuna geçirir ve kütüphaneciyi uyarır."
                                       FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== SCREEN H: OVERDUE BOOKS ==================== -->
        <Grid Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Overdue}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Overdue Summary & Filter Bar -->
            <Border Grid.Row="0" Style="{StaticResource Panel.Section}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding OverdueSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input.TextBox}"
                             ToolTip="Gecikmiş kitap adı, barkod veya üye ara..." />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Brush.Status.DangerBg}" BorderBrush="{StaticResource Brush.Status.DangerBorder}" BorderThickness="1" CornerRadius="3" Padding="10,4" Margin="0,0,10,0">
                            <TextBlock FontSize="12" Foreground="{StaticResource Brush.Status.DangerText}">
                                <Run Text="Toplam Gecikmiş: " />
                                <Run Text="{Binding OverdueBooksCount, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=" Kitap" />
                            </TextBlock>
                        </Border>
                        <Border Background="{StaticResource Brush.Status.WarningBg}" BorderBrush="{StaticResource Brush.Status.WarningBorder}" BorderThickness="1" CornerRadius="3" Padding="10,4" Margin="0,0,10,0">
                            <TextBlock FontSize="12" Foreground="{StaticResource Brush.Status.WarningText}">
                                <Run Text="Kritik (&gt;7 Gün): " />
                                <Run Text="{Binding CriticalOverdueCount, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=" Kitap" />
                            </TextBlock>
                        </Border>
                        <Border Background="{StaticResource Brush.Surface.Subtle}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="3" Padding="10,4">
                            <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text.Primary}">
                                <Run Text="Tahakkuk Eden Gecikme Bedeli: " Foreground="{StaticResource Brush.Text.Secondary}" />
                                <Run Text="{Binding TotalUnpaidFinesText, Mode=OneWay}" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="Bold" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Overdue Escalation Table -->
            <Border Grid.Row="2" Style="{StaticResource Panel.Section}">
                <DataGrid ItemsSource="{Binding OverdueRecordsList}"
                          Style="{StaticResource Grid.Archival}"
                          BorderThickness="0"
                          RowHeight="50">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ÖNCELİK SEVİYESİ" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.Status.DangerBg}"
                                            BorderBrush="{StaticResource Brush.Status.DangerBorder}"
                                            BorderThickness="3,1,1,1"
                                            CornerRadius="3" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding SeverityLevel}" Foreground="{StaticResource Brush.Status.DangerText}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="GECİKME SÜRESİ" Binding="{Binding OverdueDays, StringFormat='+{0} Gün'}" Width="115" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="Bold" FontSize="12.5" />
                        <DataGridTemplateColumn Header="GECİKEN KİTAP VE BARKOD" Width="1.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding BookTitle}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}">
                                            <Run Text="{Binding BookAuthor, Mode=OneWay}" />
                                            <Run Text=" • Barkod: " />
                                            <Run Text="{Binding BookBarcode, Mode=OneWay}" FontFamily="{StaticResource Font.Family.Mono}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ÜYE VE İLETİŞİM BİLGİLERİ" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding MemberName}" FontWeight="SemiBold" FontSize="12.5" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" FontFamily="{StaticResource Font.Family.Mono}">
                                            <Run Text="{Binding MemberNumber, Mode=OneWay}" />
                                            <Run Text=" • Tel: " />
                                            <Run Text="{Binding MemberPhone, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="VERİLİŞ TARİHİ" Binding="{Binding BorrowDateText, Mode=OneWay}" Width="105" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11.5" />
                        <DataGridTextColumn Header="SON TESLİM TARİHİ" Binding="{Binding DueDateText, Mode=OneWay}" Width="120" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="SemiBold" FontSize="11.5" />
                        <DataGridTextColumn Header="GECİKME BEDELİ" Binding="{Binding CalculatedFineText, Mode=OneWay}" Width="115" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="Bold" FontSize="12" />
                        <DataGridTemplateColumn Header="İŞLEM" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✓ İade Al ve Kapat"
                                            Style="{StaticResource Button.CompactPrimary}"
                                            Command="{Binding DataContext.ProcessReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ==================== SCREEN I: REPORTS AND ANALYTICS ==================== -->
        <Grid Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Reports}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Category & Dewey Inventory Distribution -->
            <Border Grid.Column="0" Style="{StaticResource Panel.Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource Brush.Surface.Subtle}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="16,0">
                        <TextBlock Text="KATEGORİ VE DEWEY SINIFLAMASINA GÖRE ENVANTER &amp; DOLAŞIM RAPORU" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CategoryStatsList}"
                              Style="{StaticResource Grid.Archival}"
                              BorderThickness="0"
                              RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DEWEY" Binding="{Binding DeweyCode, Mode=OneWay}" Width="85" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="Bold" FontSize="12" />
                            <DataGridTextColumn Header="KATEGORİ ADI" Binding="{Binding CategoryName, Mode=OneWay}" Width="*" FontWeight="SemiBold" FontSize="12.5" />
                            <DataGridTextColumn Header="BAŞLIK" Binding="{Binding TitleCount, StringFormat='{}{0} Eser'}" Width="85" FontFamily="{StaticResource Font.Family.Mono}" FontSize="12" />
                            <DataGridTextColumn Header="NÜSHA" Binding="{Binding CopyCount, StringFormat='{}{0} Adet'}" Width="85" FontFamily="{StaticResource Font.Family.Mono}" FontSize="12" />
                            <DataGridTextColumn Header="TOPLAM ÖDÜNÇ" Binding="{Binding LoanCount, StringFormat='{}{0} İşlem'}" Width="105" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="SemiBold" FontSize="12" />
                            <DataGridTextColumn Header="PAY (%)" Binding="{Binding SharePercentage, StringFormat='%{0:F1}'}" Width="80" FontFamily="{StaticResource Font.Family.Mono}" FontSize="12" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Monthly Ledger Table -->
            <Border Grid.Column="2" Style="{StaticResource Panel.Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource Brush.Surface.Subtle}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="16,0">
                        <TextBlock Text="12 AYLIK DOLAŞIM VE İADE PERFORMANS TABLOSU" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding MonthlyStatsList}"
                              Style="{StaticResource Grid.Archival}"
                              BorderThickness="0"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DÖNEM / AY" Binding="{Binding MonthName, Mode=OneWay}" Width="*" FontWeight="SemiBold" FontSize="12.5" />
                            <DataGridTextColumn Header="ÖDÜNÇ VERİLEN" Binding="{Binding BorrowedCount, Mode=OneWay}" Width="115" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="SemiBold" FontSize="12" />
                            <DataGridTextColumn Header="İADE ALINAN" Binding="{Binding ReturnedCount, Mode=OneWay}" Width="110" FontFamily="{StaticResource Font.Family.Mono}" FontSize="12" />
                            <DataGridTextColumn Header="GECİKEN" Binding="{Binding OverdueCount, Mode=OneWay}" Width="90" FontFamily="{StaticResource Font.Family.Mono}" FontSize="12" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== SCREEN J1: USER MANAGEMENT ==================== -->
        <Grid Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Users}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel.Section}">
                <DataGrid ItemsSource="{Binding UsersList}"
                          SelectedItem="{Binding EditableUser, Mode=TwoWay}"
                          Style="{StaticResource Grid.Archival}"
                          BorderThickness="0"
                          RowHeight="48">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KULLANICI ADI" Binding="{Binding Username, Mode=OneWay}" Width="125" FontFamily="{StaticResource Font.Family.Mono}" FontWeight="Bold" FontSize="12" />
                        <DataGridTextColumn Header="AD SOYAD" Binding="{Binding FullName, Mode=OneWay}" Width="1.3*" FontWeight="SemiBold" FontSize="13" />
                        <DataGridTextColumn Header="KURUMSAL ÜNVAN" Binding="{Binding Title, Mode=OneWay}" Width="1.4*" FontSize="12" />
                        <DataGridTextColumn Header="YETKİ ROLÜ" Binding="{Binding Role, Mode=OneWay}" Width="140" FontWeight="SemiBold" FontSize="12" />
                        <DataGridTextColumn Header="SON OTURUM" Binding="{Binding LastLoginText, Mode=OneWay}" Width="130" FontFamily="{StaticResource Font.Family.Mono}" FontSize="11.5" />
                        <DataGridTextColumn Header="DURUM" Binding="{Binding StatusText, Mode=OneWay}" Width="85" FontWeight="SemiBold" FontSize="12" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel.Section}" Padding="18,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="PERSONEL VE YETKİ HESABI" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Primary}" VerticalAlignment="Center" />
                        <Button Content="+ Yeni Personel"
                                Style="{StaticResource Button.Compact}"
                                Command="{Binding StartNewUserCommand}"
                                HorizontalAlignment="Right" />
                    </DockPanel>

                    <TextBlock Text="Kullanıcı Adı *" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EditableUser.Username}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" Margin="0,0,0,10" />

                    <TextBlock Text="Ad Soyad *" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EditableUser.FullName}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,10" />

                    <TextBlock Text="Kurumsal Görev / Ünvan" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EditableUser.Title}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,10" />

                    <TextBlock Text="Sistem Yetki Rolü" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EditableUser.Role}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,10" />

                    <TextBlock Text="E-Posta" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EditableUser.Email}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,10" />

                    <TextBlock Text="Telefon" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EditableUser.Phone}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" Margin="0,0,0,10" />

                    <TextBlock Text="Giriş Parolası" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EditableUser.PasswordHash}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" Margin="0,0,0,14" />

                    <Button Content="✓ Personel Hesabını Kaydet"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding SaveUserCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== SCREEN J2: SETTINGS & MARIADB CONFIGURATION ==================== -->
        <Grid Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVisConverter}, ConverterParameter=Settings}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Library Circulation Rules -->
            <Border Grid.Column="0" Style="{StaticResource Panel.Section}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="KÜTÜPHANE DOLAŞIM KURALLARI VE KURUMSAL PARAMETRELER" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Primary}" Margin="0,0,0,14" />

                    <TextBlock Text="Kütüphane Resmi Adı" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EditableSettings.LibraryName}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,12" />

                    <TextBlock Text="Bağlı Kurum / Vakıf / Üniversite" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EditableSettings.InstitutionName}" Style="{StaticResource Input.TextBox}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Standart Ödünç Süresi (Gün)" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableSettings.StandardLoanDays}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Akademik Ödünç Süresi (Gün)" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableSettings.AcademicLoanDays}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Standart Üye Maks. Kitap Kotası" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableSettings.MaxBooksStandard}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Akademik Üye Maks. Kitap Kotası" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableSettings.MaxBooksAcademic}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Günlük Gecikme Bedeli (₺)" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableSettings.DailyOverdueFee}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Maksimum Süre Uzatma Hakkı" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableSettings.MaxRenewalCount}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                        </StackPanel>
                    </Grid>

                    <Button Content="✓ Kütüphane Kurallarını Uygula ve Kaydet"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding SaveSettingsCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Right: MariaDB Connection & Schema Management -->
            <Border Grid.Column="2" Style="{StaticResource Panel.Section}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="MARIADB VERİTABANI BAĞLANTI BİLGİLERİ" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Primary}" Margin="0,0,0,10" />

                    <Border Style="{StaticResource Panel.SubtleWell}" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="AKTİF VERİTABANI DURUMU" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding ConnectionStatusText}" FontFamily="{StaticResource Font.Family.Mono}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.SuccessText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MariaDB Sunucu Adresi (Host)" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableSettings.DbHost}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Port" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableSettings.DbPort}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Veritabanı Adı (Şema)" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EditableSettings.DbName}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Kullanıcı Adı" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableSettings.DbUser}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Parola" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding EditableSettings.DbPassword}" Style="{StaticResource Input.TextBox}" FontFamily="{StaticResource Font.Family.Mono}" />
                        </StackPanel>
                    </Grid>

                    <Button Content="Bağlantıyı Test Et ve MariaDB Şemasını Senkronize Et"
                            Style="{StaticResource Button.Bronze}"
                            Command="{Binding TestMariaDbConnectionCommand}" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>

