<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== NAVIGATION & SHELL SURFACES ==================== -->
    <Color x:Key="Color.Surface.Sidebar">#16211D</Color>
    <Color x:Key="Color.Surface.SidebarDeep">#101815</Color>
    <Color x:Key="Color.Surface.SidebarHover">#1F2E28</Color>
    <Color x:Key="Color.Surface.SidebarActive">#263831</Color>
    <Color x:Key="Color.Text.SidebarPrimary">#EAE6DF</Color>
    <Color x:Key="Color.Text.SidebarMuted">#8F9D96</Color>

    <SolidColorBrush x:Key="Brush.Surface.Sidebar" Color="{StaticResource Color.Surface.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface.SidebarDeep" Color="{StaticResource Color.Surface.SidebarDeep}" />
    <SolidColorBrush x:Key="Brush.Surface.SidebarHover" Color="{StaticResource Color.Surface.SidebarHover}" />
    <SolidColorBrush x:Key="Brush.Surface.SidebarActive" Color="{StaticResource Color.Surface.SidebarActive}" />
    <SolidColorBrush x:Key="Brush.Text.SidebarPrimary" Color="{StaticResource Color.Text.SidebarPrimary}" />
    <SolidColorBrush x:Key="Brush.Text.SidebarMuted" Color="{StaticResource Color.Text.SidebarMuted}" />

    <!-- ==================== PRIMARY WORKSPACE SURFACES ==================== -->
    <Color x:Key="Color.Surface.Canvas">#F6F4EF</Color>
    <Color x:Key="Color.Surface.Panel">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Subtle">#EFECE6</Color>
    <Color x:Key="Color.Surface.SelectedRow">#E6EFEA</Color>
    <Color x:Key="Color.Surface.HoverRow">#F2F0EB</Color>

    <SolidColorBrush x:Key="Brush.Surface.Canvas" Color="{StaticResource Color.Surface.Canvas}" />
    <SolidColorBrush x:Key="Brush.Surface.Panel" Color="{StaticResource Color.Surface.Panel}" />
    <SolidColorBrush x:Key="Brush.Surface.Subtle" Color="{StaticResource Color.Surface.Subtle}" />
    <SolidColorBrush x:Key="Brush.Surface.SelectedRow" Color="{StaticResource Color.Surface.SelectedRow}" />
    <SolidColorBrush x:Key="Brush.Surface.HoverRow" Color="{StaticResource Color.Surface.HoverRow}" />

    <!-- ==================== BRAND & ACCENT COLORS ==================== -->
    <Color x:Key="Color.Accent.Primary">#1E4D3B</Color>
    <Color x:Key="Color.Accent.PrimaryHover">#163A2C</Color>
    <Color x:Key="Color.Accent.PrimaryPressed">#102B20</Color>
    <Color x:Key="Color.Accent.Secondary">#B08342</Color>
    <Color x:Key="Color.Accent.SecondarySubtle">#F7F1E5</Color>

    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent.PrimaryHover" Color="{StaticResource Color.Accent.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.Accent.PrimaryPressed" Color="{StaticResource Color.Accent.PrimaryPressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Secondary" Color="{StaticResource Color.Accent.Secondary}" />
    <SolidColorBrush x:Key="Brush.Accent.SecondarySubtle" Color="{StaticResource Color.Accent.SecondarySubtle}" />

    <!-- ==================== TYPOGRAPHY & HIERARCHY ==================== -->
    <Color x:Key="Color.Text.Primary">#181C1A</Color>
    <Color x:Key="Color.Text.Secondary">#525B56</Color>
    <Color x:Key="Color.Text.Muted">#7E8782</Color>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />

    <!-- ==================== BORDERS & DIVIDERS ==================== -->
    <Color x:Key="Color.Border.Default">#DCD8CF</Color>
    <Color x:Key="Color.Border.Subtle">#EAE6DF</Color>
    <Color x:Key="Color.Border.Strong">#B8B3A8</Color>

    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />

    <!-- ==================== SEMANTIC STATUS SYSTEM ==================== -->
    <SolidColorBrush x:Key="Brush.Status.SuccessText" Color="#1B5E3A" />
    <SolidColorBrush x:Key="Brush.Status.SuccessBg" Color="#E6F2EB" />
    <SolidColorBrush x:Key="Brush.Status.SuccessBorder" Color="#B8DCC7" />

    <SolidColorBrush x:Key="Brush.Status.WarningText" Color="#965A16" />
    <SolidColorBrush x:Key="Brush.Status.WarningBg" Color="#FDF3E4" />
    <SolidColorBrush x:Key="Brush.Status.WarningBorder" Color="#EBD0A4" />

    <SolidColorBrush x:Key="Brush.Status.DangerText" Color="#9E2A2B" />
    <SolidColorBrush x:Key="Brush.Status.DangerBg" Color="#FBEAEB" />
    <SolidColorBrush x:Key="Brush.Status.DangerBorder" Color="#E8B8B9" />

    <SolidColorBrush x:Key="Brush.Status.InfoText" Color="#23527C" />
    <SolidColorBrush x:Key="Brush.Status.InfoBg" Color="#E8F0F8" />
    <SolidColorBrush x:Key="Brush.Status.InfoBorder" Color="#BDD4EA" />

</ResourceDictionary>

