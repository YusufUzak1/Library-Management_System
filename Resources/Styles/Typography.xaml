<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== EMBEDDED FONT FAMILIES ==================== -->
    <FontFamily x:Key="Font.Family.Sans">pack://application:,,,/Resources/Fonts/#Source Sans 3, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Family.Serif">pack://application:,,,/Resources/Fonts/#Source Serif 4, Georgia</FontFamily>
    <FontFamily x:Key="Font.Family.Mono">pack://application:,,,/Resources/Fonts/#IBM Plex Mono, Consolas</FontFamily>

    <!-- ==================== DISPLAY & EDITORIAL SERIF HEADINGS ==================== -->
    <Style x:Key="Text.Display.Hero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Serif}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Serif}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Text.KpiValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Serif}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <!-- ==================== INTERFACE SANS-SERIF HIERARCHY ==================== -->
    <Style x:Key="Text.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Sans}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Text.Subheader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Sans}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Sans}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Text.BodySecondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Sans}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Sans}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Sans}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
    </Style>

    <Style x:Key="Text.Mono.Code" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Mono}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

</ResourceDictionary>

